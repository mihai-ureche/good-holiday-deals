# Use a hex password to avoid URL-escaping problems in DATABASE_URL.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-generated-hex-password
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
APP_HOST=travel.binarium.ro
DIGEST_TIMEZONE=Europe/Bucharest
# Keep disabled until the mailbox, permissions, and invited recipients are ready.
EMAIL_MODE=disabled
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
# Optional. Create a free account at https://ignav.com/signup. Keep this key on
# the backend; never expose it to browser JavaScript.
IGNAV_API_KEY=
# Optional. Create a server-side access token in the Duffel dashboard. Stays
# must also be enabled for the account. Duffel Links requires a public HTTPS APP_URL.
DUFFEL_ACCESS_TOKEN=
# Optional public HTTPS callback base for Duffel Links. Defaults to APP_URL.
DUFFEL_LINKS_APP_URL=
# Optional Sabre CERT integration. Keep the complete V1:user:group:domain user
# ID and password on the backend. SABRE_PCC is the separate four-character PCC.
# Set SABRE_ENVIRONMENT=production only after Sabre issues production access.
SABRE_USER_ID=
SABRE_PASSWORD=
SABRE_PCC=
SABRE_ENVIRONMENT=cert
# Public HTTPS entry point of your Sabre reprice/booking workflow. Sabre's test
# credentials are search-only and Sabre does not supply a hosted checkout link.
SABRE_BOOKING_URL=
