# Use a hex password to avoid URL-escaping problems in DATABASE_URL.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-generated-hex-password
NODE_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
APP_HOST=travel.binarium.ro
DIGEST_TIMEZONE=Europe/Bucharest
# Keep disabled until the mailbox, permissions, and invited recipients are ready.
EMAIL_MODE=disabled
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
# Optional. Create a free account at https://ignav.com/signup. Keep this key on
# the backend; never expose it to browser JavaScript.
IGNAV_API_KEY=
# Optional. Create a server-side access token in the Duffel dashboard. The
# integration uses Flights and Links only. Duffel Links requires a public HTTPS APP_URL.
DUFFEL_ACCESS_TOKEN=
# Optional public HTTPS callback base for Duffel Links. Defaults to APP_URL.
DUFFEL_LINKS_APP_URL=
# Optional. Server-side SearchAPI key used for Google Hotels and property-rate
# lookups. The integration does not use SearchAPI for flights.
SEARCHAPI_API_KEY=
