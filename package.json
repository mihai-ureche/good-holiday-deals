{
  "name": "good-holiday-deals",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:db": "docker compose --env-file .env --env-file .env.local -f compose.yaml -f compose.dev.yaml up -d --wait db",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx --watch apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace @holiday/web",
    "dev:worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx --watch apps/worker/src/main.ts",
    "build": "tsc -p tsconfig.server.json && npm run build --workspace @holiday/web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/apps/api/src/server.js",
    "worker": "node dist/apps/worker/src/main.js",
    "invite": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx apps/api/src/invite.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.8",
    "cheerio": "^1.2.0",
    "fastify": "^5.0.0",
    "pg": "^8.16.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
